# --- HiveMQ Cloud (isi dari halaman cluster & Access Management) ---
BROKER_HOST=GANTI-DENGAN-CLUSTER-ID.s1.eu.hivemq.cloud
BROKER_PORT=8883
BROKER_TLS=true
BROKER_USER="RulNet"
BROKER_PASS="meow12311"

# Samakan PROJECT_ID di laptop dan di kedua HP (ubah jadi nama kelompokmu)
PROJECT_ID=crash_kelompok_11
DASHBOARD_PORT=8000

# Ambang deteksi ED1 (turunkan untuk uji sambil berjalan, mis. SPEED_BEFORE_KPH=3 IMPACT_G=2)
SPEED_BEFORE_KPH=3
STOP_KPH=2
IMPACT_G=2
ROTATION_DPS=150

# Lokasi live ED1 -> ED2 (hemat baterai/kuota: kirim bila cukup lama ATAU cukup jauh)
LOCATION_INTERVAL_S=5
LOCATION_MIN_MOVE_M=10
LOCATION_HEARTBEAT_S=30
LOCATION_MAX_ACC_M=100
